{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sprunki-jam",
  "compatibility_date": "2026-08-28",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  // Cache-Control / X-Robots-Tag live in public/_headers (copied into dist/).
  // Workers static assets parse that metafile — there is no extra headers map here.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
